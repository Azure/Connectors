{
  "name": "memegenerator",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "preinstall": "brew install pkg-config cairo pango libpng jpeg giflib",
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "echo \"No tests yet...\"",
    "install:onedrive-connector": "npm i @azure/onedrive-connector --registry https://npm.pkg.github.com/Azure --save-optional",
    "install:microsoftteams-connector": "npm i @azure/microsoftteams-connector --registry https://npm.pkg.github.com/Azure --save-optional",
    "postinstall": "npm run install:onedrive-connector && npm run install:microsoftteams-connector"
  },
  "dependencies": {
    "@azure/identity": "^1.1.0",
    "@azure/ms-rest-js": "^2.0.8",
    "@azure/ms-rest-azure-js": "2.0.1",
    "@types/node": "^14.11.2",
    "nodejs-meme-generator": "^1.0.4",
    "themememaker": "^0.0.5"
  },
  "devDependencies": {
    "@azure/functions": "^1.0.2-beta2",
    "typescript": "^3.3.3"
  },
  "optionalDependencies": {
    "@azure/microsoftteams-connector": "0.0.5-alpha",
    "@azure/onedrive-connector": "0.0.5-alpha"
  }
}
