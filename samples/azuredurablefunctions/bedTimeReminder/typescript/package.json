{
  "name": "connector-durable-devops",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "echo \"No tests yet...\"",
    "install:office365outlook-connector": "npm i @azure/office365outlook-connector --registry https://npm.pkg.github.com/Azure --save-optional",
    "install:microsoftteams-connector": "npm i @azure/microsoftteams-connector --registry https://npm.pkg.github.com/Azure --save-optional",
    "postinstall": "npm run install:office365outlook-connector && npm run install:microsoftteams-connector"
  },
  "dependencies": {
    "@azure/identity": "^1.1.0",
    "@azure/ms-rest-js": "^2.0.8",
