    "durable-functions": "^1.4.3",
    "moment": "^2.28.0",
    "moment-timezone": "^0.5.31"
  },
  "devDependencies": {
    "@azure/functions": "^1.0.2-beta2",
    "typescript": "^3.3.3"
  },
  "optionalDependencies": {
    "@azure/microsoftteams-connector": "0.0.5-alpha",
    "@azure/office365outlook-connector": "0.0.5-alpha"
  }
}
