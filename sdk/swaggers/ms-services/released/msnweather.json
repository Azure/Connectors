  "info": {
    "contact": {
      "name": "Microsoft"
    },
    "description": "MSN Weather gets you the very latest weather forecast, including temperature, humidity, precipitation for your location.",
    "title": "MSN Weather",
    "version": "1.0.0",
    "x-ms-api-annotation": {
      "status": "Production"
    },
    "x-ms-connector-name": "msnweather"
  },
  "parameters": {
    "Location": {
      "description": "The location search query.  Valid inputs are City, Region, State, Country, Landmark, PostalCode, and Lat.Long.",
      "in": "path",
      "name": "Location",
      "required": true,
      "type": "string",
      "x-ms-summary": "Location",
      "x-ms-test-value": "Redmond "
    },
    "Measure": {
      "default": "Temperature",
      "description": "The weather measure used for this operation. Valid options are 'Temperature', 'UV Index', 'Humidity' or 'Wind Speed'.",
      "enum": [
        "Temperature",
        "UV Index",
        "Humidity",
        "Wind Speed"
      ],
      "in": "query",
      "name": "Measure",
      "required": true,
      "type": "string",
      "x-ms-summary": "Measure"
    },
    "Units": {
      "default": "Imperial",
      "description": "The measurement system used for all the meausre values in the request and response. Valid options are 'Imperial' and 'Metric'.",
      "enum": [
        "Imperial",
        "Metric"
      ],
      "in": "query",
      "name": "units",
      "required": true,
      "type": "string",
      "x-ms-summary": "Units"
    }
  },
