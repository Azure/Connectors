          "description": "The datetime the article was published.",
          "format": "date-time",
          "type": "string",
          "x-ms-summary": "Date Published"
        },
        "description": {
          "description": "A short description of the news article.",
          "type": "string",
          "x-ms-summary": "Description"
        },
        "name": {
          "description": "The name of the news article.",
          "type": "string",
