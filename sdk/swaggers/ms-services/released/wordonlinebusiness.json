            "required": true,
            "type": "string"
          },
          {
            "default": "file",
            "in": "query",
            "name": "file",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        },
        "summary": "Fetches the schema of the selected file",
        "x-ms-visibility": "internal"
      }
    },
